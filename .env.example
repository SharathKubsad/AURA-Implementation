# Environment Variables Example
# Copy to .env and adjust variables as needed

APP_ENV=development
LOG_LEVEL=INFO

# API Service
API_HOST=0.0.0.0
API_PORT=8000

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fileless-malware-detection

# Model & Configuration Paths
CONFIG_DIR=configs
DATA_DIR=data
MODELS_DIR=models
